pipeline {
    agent any
    
    parameters {
    choice(name: 'NODE_LABEL', choices: ['default_node','jenkins_node'], description: 'Select the node to run the build')
}

    stages {
        stage('Checkout Code') {
            steps {
                echo "Checking out code from branch: ${env.BRANCH_NAME}"
                // git url: 'https://github.com/adhithya-1525/jenkins-repo.git', branch: "${env.BRANCH_NAME}"
            }
        }
        
        stage('Build on Selected Node') {
            agent { label "${params.NODE_LABEL}" }  // Runs on the selected node
            steps {
                echo "Running build on node: ${params.NODE_LABEL}"
            }
        }

        stage('Build') {
            steps {
                echo "Building the application..."
            }
        }

        stage('Test') {
            steps {
                echo "Running tests..."
            }
        }

        stage('Deploy') {
            // when { branch 'main' }  // Only deploy if it's the 'main' branch
            steps {
                echo "Deploying the application..."
                // Add deployment steps (e.g., copy files, run Docker, deploy to server)
            }
        }
    }
    post {
    success {
       // sendGoogleChatNotification("✅ Build Successful! 🎉")
        emailext(
            subject: "✅ Build Successful: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            body: """<h3>🎉 Build Success</h3>
                     <p><b>Job Name:</b> ${env.JOB_NAME}</p>
                     <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                     <p><b>Build URL:</b> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>""",
            recipientProviders: [[$class: 'CulpritsRecipientProvider']],
            to: "adhiadhithyakutty999@gmail.com",
            mimeType: 'text/html'
        )
    }

    failure {
        //sendGoogleChatNotification("❌ Build Failed! 🔴")
        emailext(
            subject: "❌ Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            body: """<h3>🔴 Build Failed</h3>
                     <p><b>Job Name:</b> ${env.JOB_NAME}</p>
                     <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                     <p><b>Console Output:</b> <a href="${env.BUILD_URL}/console">${env.BUILD_URL}/console</a></p>""",
            recipientProviders: [[$class: 'CulpritsRecipientProvider']],
            to: "adhiadhithyakutty999@gmail.com",
            mimeType: 'text/html'
        )
    }
}
}
