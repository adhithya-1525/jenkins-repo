pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo "Building the project..."
                // Simulating build success
            }
        }
    }

    post {
        always {
            script {
                def status = currentBuild.currentResult
                sendGoogleChatNotification("Build ${status}!")
            }

            emailext(
                subject: "Build ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    Build Status: ${currentBuild.currentResult}
                    Job Name: ${env.JOB_NAME}
                    Build Number: ${env.BUILD_NUMBER}
                    Console Output: ${env.BUILD_URL}/console
                """,
                recipientProviders: [[$class: 'CulpritsRecipientProvider']],
                to: "your-email@example.com"
            )
        }
    }
}

// Function to send notifications to Google Chat
def sendGoogleChatNotification(String message) {
    withCredentials([string(credentialsId: 'GOOGLE_CHAT_WEBHOOK', variable: 'GOOGLE_CHAT_WEBHOOK')]) {
        def jobName = env.JOB_NAME
        def buildNumber = env.BUILD_NUMBER
        def buildUrl = env.BUILD_URL

        def payload = """{
            "text": "${message} \nJob: ${jobName} \nBuild: #${buildNumber} \nURL: ${buildUrl}"
        }"""

        sh """curl -X POST -H 'Content-Type: application/json' -d '${payload}' '${GOOGLE_CHAT_WEBHOOK}'"""
    }
}

