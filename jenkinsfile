pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo "Building the project..."
                // Simulating build success
            }
        }
    }
    post {
        success {
            sendGoogleChatNotification(" Build Successful!")
        }
        failure {
            sendGoogleChatNotification(" Build Failed!")
        }
    }
}    
// Function to send notifications to Google Chat
def sendGoogleChatNotification(String status) {
    def googleChatWebhook = "https://chat.googleapis.com/v1/spaces/AAAAMyrH_T0/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=tM6-wN3x3kHpCFD8cwlZ8fwIh0ll3iMsMSIUbbNjdnA"
    def jobName = env.JOB_NAME
    def buildNumber = env.BUILD_NUMBER
    def buildUrl = env.BUILD_URL
    
    def payload = """{
        "text": "${status} \nJob: ${jobName} \nBuild: #${buildNumber} \nURL: ${buildUrl}"
    }"""

    sh """curl -X POST -H 'Content-Type: application/json' -d '${payload}' '${googleChatWebhook}'"""
}
post {
    always {
        emailext(
            subject: "Build ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            body: """
                Build Status: ${currentBuild.currentResult}
                Job Name: ${env.JOB_NAME}
                Build Number: ${env.BUILD_NUMBER}
                Console Output: ${env.BUILD_URL}/console
            """,
            recipientProviders: [[$class: 'CulpritsRecipientProvider']],
            to: "your-email@example.com"
        )
    }
}




