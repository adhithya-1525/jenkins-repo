pipeline {
    agent any

    stages { 
        stage('one') {
            steps {
                echo "hi this is stage one"
            }
        }
        stage('two') {
            steps {
                echo "hi this is stage two"
            }
        }
    }

    //post {
      //  success {
        //    sendGoogleChatNotification("✅ Build Successful! 🎉")
       // }
       // failure {
         //   sendGoogleChatNotification("❌ Build Failed! 🔴")
       // }
   // }
	post {
    	success {
               sendGoogleChatNotification("✅ Build Successful! 🎉")
        	emailext(
            	subject: "✅ Build Successful: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
           	body: """<h3>🎉 Build Success</h3>
                     <p><b>Job Name:</b> ${env.JOB_NAME}</p>
                     <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                     <p><b>Build URL:</b> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>""",
           	 recipientProviders: [[$class: 'CulpritsRecipientProvider']],
            	 to: "adhiadhithyakutty999@gmail.com",
            	 mimeType: 'text/html'
        )
    }

    	failure {
                 sendGoogleChatNotification("❌ Build Failed! 🔴")
       	  emailext(
                 subject: "❌ Build Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: """<h3>🔴 Build Failed</h3>
                     <p><b>Job Name:</b> ${env.JOB_NAME}</p>
                     <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                     <p><b>Console Output:</b> <a href="${env.BUILD_URL}/console">${env.BUILD_URL}/console</a></p>""",
                 recipientProviders: [[$class: 'CulpritsRecipientProvider']],
                 to: "adhiadhithyakutty999@gmail.com",
                 mimeType: 'text/html'
        )
    }
}
}

// Secure function for Google Chat notifications

def sendGoogleChatNotification(String status) {
    def googleChatWebhook = "https://chat.googleapis.com/v1/spaces/AAAAMyrH_T0/messages?key=AIzaSyDdI0hCZtE6vySjMm-WEfRq3CPzqKqqsHI&token=tM6-wN3x3kHpCFD8cwlZ8fwIh0ll3iMsMSIUbbNjdnA"
    def jobName = env.JOB_NAME
    def buildNumber = env.BUILD_NUMBER
    def buildUrl = env.BUILD_URL
    
    def payload = """{
        "text": "${status} \nJob: ${jobName} \nBuild: #${buildNumber} \nURL: ${buildUrl}"
    }"""

    sh """curl -X POST -H 'Content-Type: application/json' -d '${payload}' '${googleChatWebhook}'"""
}

